{
  "name": "steward",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted fleet-and-data guardian: indexes your machines, keeps novel data redundant, converges every box to your setup.",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/daemon/main.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "bun run src/daemon/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "test:unit": "bun test tests/fsops.test.ts tests/api.test.ts tests/term.test.ts tests/scan.test.ts tests/install.test.ts",
    "test:e2e": "bun test tests/e2e.test.ts"
  },
  "dependencies": {
    "bun-pty": "^0.4.10",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "playwright": "^1.62.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
